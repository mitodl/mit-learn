{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>mitodl/.github:renovate-config"],
  "packageRules": [
    {
      "allowedVersions": "<6",
      "matchPackageNames": ["django", "Django"]
    },
    {
      "description": "CI tests against prod's engine: ol-mitlearn-db-production runs postgres 15.17.",
      "allowedVersions": "<16",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["postgres"]
    },
    {
      "description": "Local compose stays a major ahead of prod for now; this keeps 16.x patches flowing without offering 17+.",
      "allowedVersions": "<17",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["postgres"]
    },
    {
      "description": "Prod domain opensearch-mitlearn-producti runs OpenSearch_3.3.",
      "allowedVersions": "<3.4",
      "matchPackageNames": ["opensearchproject/opensearch"]
    },
    {
      "description": "Keep the local server in the series qdrant-client ~=1.18.0 targets.",
      "allowedVersions": "<1.19",
      "matchPackageNames": ["qdrant/qdrant"]
    },
    {
      "description": "Digest pins on local dev compose images are churn without a supply-chain benefit; Dockerfiles and Actions keep them.",
      "matchManagers": ["docker-compose"],
      "pinDigests": false
    }
  ]
}
