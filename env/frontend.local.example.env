NEXT_PUBLIC_STAY_UPDATED_HUBSPOT_FORM_ID=""

# HubSpot form id for the /organizational-learning lead form. Form ids are
# scoped to a HubSpot portal, and dev/RC use the xprodev account rather than
# production — so this differs per environment. Leave empty and the form area
# reports itself unavailable instead of rendering.
#
# This is the form the Universal AI landing page already submits to (portal
# 4994459). MITOL_HUBSPOT_API_PRIVATE_TOKEN must be a token for that same
# portal, or the definition fetch returns the missing-token response.
NEXT_PUBLIC_ORG_LEARNING_HUBSPOT_FORM_ID="60a1983b-361a-4e80-a0db-d24ff636d7bf"

# Optional local GTM overrides (server-side runtime)
# GTM_TRACKING_ID=
# GTM_AUTH=
# GTM_PREVIEW=
# GTM_COOKIES_WIN=

# learn-ai integration: route the AI agents through MIT Learn's APISIX gateway
# (/ai/* is proxied to the local learn-ai service). See "Connecting with learn-ai"
# in the README. Requires learn-ai running locally.
# NEXT_PUBLIC_LEARN_AI_RECOMMENDATION_ENDPOINT=http://open.odl.local:8065/ai/http/recommendation_agent/
# NEXT_PUBLIC_LEARN_AI_SYLLABUS_ENDPOINT=http://open.odl.local:8065/ai/http/syllabus_agent/

# ol-analytics-api integration: supplies the data for the B2B org analytics
# dashboard at /dashboard/organization/<org>/analytics. Whether that route is
# reachable at all is controlled by the b2b-analytics-dashboard PostHog flag,
# not by this variable: with the flag on and this unset the page still renders,
# reporting "Analytics is not available in this environment".
# Point at the APISIX route rather than the API directly — the API expects the
# JWT that APISIX mints from the session cookie.
# NEXT_PUBLIC_ANALYTICS_API_BASE_URL=http://open.odl.local:8065/analytics/
